boolean gameEnd = false;
int respawn = 60;

icon cube;
g ground;
ArrayList<spike> spikes;

void setup() {
  size(1920,1080);
  background(100,100,100);
  cube = new icon (350,667,100,100);
  ground = new g (0,2*height/3,width,height/3);
  spikes = new ArrayList<spike>();
  spikes.add(new spike(2000,667,100,100));
  spikes.add(new spike(2100,667,100,100));
  spikes.add(new spike(2200,667,100,100));
}


void draw() {
  background(100, 100, 100); 
  ground.display();
  cube.display();
  if (!gameEnd) {
    cube.update(); 
    for (spike s : spikes) {
      s.update();
    }
  } else {
    respawn --;
    if (respawn == 0) {
      gameEnd = false;
      respawn = 60;
      cube.angle = 0;
      cube.ypos = 667;
      for (spike s : spikes) {
        s.xpos = s.origin;
      }
    }
  }
  for (spike s : spikes) {
    s.display();
    if (s.collides(cube)) {
      gameEnd = true;
    }
  }
}

void mousePressed() {
  cube.jump();
}

class g {
  float xpos, ypos, w, h;
  g (float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }
  void display() {
    rectMode(CORNER);
    noStroke();
    fill(255,255,255);
    rect(xpos,ypos,w,h);
  }
}

class icon {
  float ySpeed = 0;
  float xpos, ypos, w, h;
  float angle = 0; 
  float gravity = 2;

  icon(float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }

  void update() {
    ySpeed -= gravity;
    ypos -= ySpeed;

    if (ypos + h/2 >= height*2/3) {
      ypos = height*2/3 - h/2;
      ySpeed = 0;
      angle = 0; 
    } else {
      angle += 0.095; 
    }
  }

  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rotate(angle);
    rectMode(CENTER);
    fill(0, 200, 255);
    stroke(0);
    strokeWeight(4);
    rect(0, 0, w, h);
    fill(100, 100, 100);
    rect(0, 0, w - 40, h - 40);
    popMatrix(); 
  }
  
  void jump() {
    if (ypos + h/2 >= height*2/3 - 1) {
      ySpeed = 35; 
    }
  }
}

class spike {
  float xSpeed = 13;
  float xpos, ypos, w, h, origin;
  spike (float x, float y, float w, float h) {
    this.xpos = x;
    this.origin = xpos;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }
  void update() {
    xpos -= xSpeed;
    if (xpos < -50) {
      xpos = 2000;
    }
  }
  
  void display() {
    fill(255,0,0);
    noStroke();
    rectMode(CENTER);
    rect(xpos,ypos,w/4,h/2);
    fill(0,0,0);
    stroke(255);
    strokeWeight(4);
    triangle(xpos+(w/2),ypos+(h/2),xpos-(w/2),ypos+(h/2),xpos,ypos-(h/2));
    
  }
  boolean collides(icon i) {
    float dx = this.xpos - i.xpos;
    float dy = this.ypos - i.ypos;
    float rSpike = max(this.w/4.0, this.h/2.0) / 2.0; 
    float rIcon  = max(i.w, i.h) / 2.0;
    return dx*dx + dy*dy < (rSpike + rIcon)*(rSpike + rIcon);
  }
}
