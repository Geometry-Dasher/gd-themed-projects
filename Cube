boolean gameEnd = false;
int respawn = 60;

icon cube;
g ground;
ArrayList<spike> spikes;

float physicsInterval = 1.0 / 240.0; 
float accumulator = 0.0;
float currentTime = 0.0;
float scaleFactor;

void setup() {
  fullScreen();
  background(100, 100, 100);
  
  scaleFactor = width / 1920.0;
  currentTime = millis() / 1000.0;
  
  cube = new icon(350 * scaleFactor, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor);
  ground = new g(0, 2 * height / 3, width, height / 3);
  
  spikes = new ArrayList<spike>();
  spikes.add(new spike(2000 * scaleFactor, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor));
  spikes.add(new spike(2100 * scaleFactor, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor));
  spikes.add(new spike(2200 * scaleFactor, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor));
}

void draw() {
  float newTime = millis() / 1000.0;
  float frameTime = newTime - currentTime;
  currentTime = newTime;

  if (frameTime > 0.1) frameTime = 0.1; 
  accumulator += frameTime;

  while (accumulator >= physicsInterval) {
    updateGamePhysics(physicsInterval);
    accumulator -= physicsInterval;
  }

  background(100, 100, 100); 
  ground.display();
  cube.display();
  for (spike s : spikes) {
    s.display();
  }
}

void updateGamePhysics(float dt) {
  if (!gameEnd) {
    cube.update(dt); 
    for (spike s : spikes) {
      s.update(dt);
      if (s.collides(cube)) {
        gameEnd = true;
      }
    }
  } else {
    respawn--;
    if (respawn <= 0) {
      gameEnd = false;
      respawn = 60;
      cube.angle = 0;
      cube.ypos = (2 * height / 3) - (cube.h / 2);
      cube.ySpeed = 0;
      for (spike s : spikes) {
        s.xpos = s.origin;
      }
    }
  }
}

void mousePressed() {
  cube.jump();
}

class g {
  float xpos, ypos, w, h;
  g (float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
  }
  void display() {
    rectMode(CORNER);
    noStroke();
    fill(255);
    rect(xpos, ypos, w, h);
  }
}

class icon {
  float ySpeed = 0;
  float xpos, ypos, w, h;
  float angle = 0; 
  
  float gravity; 
  float jumpVelocity; 

  icon(float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
    this.gravity = 4500 * scaleFactor;
    this.jumpVelocity = 1400 * scaleFactor;
  }

  void update(float dt) {
    ySpeed -= gravity * dt;
    ypos -= ySpeed * dt;

    if (ypos >= (2 * height / 3) - h/2) {
      ypos = (2 * height / 3) - h/2;
      ySpeed = 0;
      angle = round(angle / PI) * PI; 
    } else {
      angle += 5.05 * dt; 
    }
  }

  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rotate(angle);
    rectMode(CENTER);
    fill(0, 200, 255);
    stroke(0);
    strokeWeight(4 * scaleFactor);
    rect(0, 0, w, h);
    fill(100, 100, 100);
    rect(0, 0, w - (40 * scaleFactor), h - (40 * scaleFactor));
    popMatrix(); 
  }
  
  void jump() {
    if (ypos >= (2 * height / 3) - h/2 - (2 * scaleFactor)) {
      ySpeed = jumpVelocity; 
    }
  }
}

class spike {
  float xSpeed; 
  float xpos, ypos, w, h, origin;
  
  spike (float x, float y, float w, float h) {
    this.xpos = x;
    this.origin = xpos;
    this.ypos = y;
    this.w = w;
    this.h = h;
    this.xSpeed = 850 * scaleFactor;
  }
  
  void update(float dt) {
    xpos -= xSpeed * dt;
    if (xpos < -150 * scaleFactor) {
      xpos = width + (280 * scaleFactor); 
    }
  }
  
  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rectMode(CENTER);
    fill(255, 0, 0);
    noStroke();
    rect(0, 0, w/4, h/2);
    
    fill(0);
    stroke(255);
    strokeWeight(4 * scaleFactor);
    triangle(w/2, h/2, -w/2, h/2, 0, -h/2);
    popMatrix();
  }
  
  boolean collides(icon i) {
    float spikeLeft = this.xpos - (this.w / 3);
    float spikeRight = this.xpos + (this.w / 3);
    float spikeTop = this.ypos - (this.h / 2);
    float spikeBottom = this.ypos + (this.h / 2);
    
    float iconLeft = i.xpos - (i.w / 2) + (10 * scaleFactor); 
    float iconRight = i.xpos + (i.w / 2) - (10 * scaleFactor);
    float iconTop = i.ypos - (i.h / 2) + (10 * scaleFactor);
    float iconBottom = i.ypos + (i.h / 2) - (10 * scaleFactor);
    
    return (spikeLeft < iconRight && spikeRight > iconLeft &&
            spikeTop < iconBottom && spikeBottom > iconTop);
  }
}
