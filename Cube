boolean gameEnd = false;
int respawn = 60;

icon cube;
g ground;
ArrayList<spike> spikes;

float physicsInterval = 1.0 / 240.0; 
float accumulator = 0.0;
float currentTime = 0.0;

void setup() {
  size(1920, 1080);
  background(100, 100, 100);
  
  currentTime = millis() / 1000.0;
  
  cube = new icon(350, 667, 100, 100);
  ground = new g(0, 2*height/3, width, height/3);
  spikes = new ArrayList<spike>();
  spikes.add(new spike(2000, 667, 100, 100));
  spikes.add(new spike(2100, 667, 100, 100));
  spikes.add(new spike(2200, 667, 100, 100));
}

void draw() {
  float newTime = millis() / 1000.0;
  float frameTime = newTime - currentTime;
  currentTime = newTime;

  if (frameTime > 0.1) frameTime = 0.1; 
  accumulator += frameTime;

  while (accumulator >= physicsInterval) {
    updateGamePhysics(physicsInterval);
    accumulator -= physicsInterval;
  }

  background(100, 100, 100); 
  ground.display();
  cube.display();
  for (spike s : spikes) {
    s.display();
  }
}

void updateGamePhysics(float dt) {
  if (!gameEnd) {
    cube.update(dt); 
    for (spike s : spikes) {
      s.update(dt);
      if (s.collides(cube)) {
        gameEnd = true;
      }
    }
  } else {
    respawn--;
    if (respawn <= 0) {
      gameEnd = false;
      respawn = 60;
      cube.angle = 0;
      cube.ypos = 667;
      cube.ySpeed = 0;
      for (spike s : spikes) {
        s.xpos = s.origin;
      }
    }
  }
}

void mousePressed() {
  cube.jump();
}

class g {
  float xpos, ypos, w, h;
  g (float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
  }
  void display() {
    rectMode(CORNER);
    noStroke();
    fill(255);
    rect(xpos, ypos, w, h);
  }
}

class icon {
  float ySpeed = 0;
  float xpos, ypos, w, h;
  float angle = 0; 
  
  float gravity = 4500; 
  float jumpVelocity = 1400; 

  icon(float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
  }

  void update(float dt) {
    ySpeed -= gravity * dt;
    ypos -= ySpeed * dt;

    if (ypos >= 720 - h/2) {
      ypos = 720 - h/2;
      ySpeed = 0;
      angle = round(angle / PI) * PI; 
    } else {
      angle += 5.05 * dt; 
    }
  }

  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rotate(angle);
    rectMode(CENTER);
    fill(0, 200, 255);
    stroke(0);
    strokeWeight(4);
    rect(0, 0, w, h);
    fill(100, 100, 100);
    rect(0, 0, w - 40, h - 40);
    popMatrix(); 
  }
  
  void jump() {
    if (ypos >= 720 - h/2 - 2) {
      ySpeed = jumpVelocity; 
    }
  }
}

class spike {
  float xSpeed = 850; 
  float xpos, ypos, w, h, origin;
  
  spike (float x, float y, float w, float h) {
    this.xpos = x;
    this.origin = xpos;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }
  
  void update(float dt) {
    xpos -= xSpeed * dt;
    if (xpos < -100) {
      xpos = 2200; 
    }
  }
  
  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rectMode(CENTER);
    fill(255, 0, 0);
    noStroke();
    rect(0, 0, w/4, h/2);
    
    fill(0);
    stroke(255);
    strokeWeight(4);
    triangle(w/2, h/2, -w/2, h/2, 0, -h/2);
    popMatrix();
  }
  
  boolean collides(icon i) {
    float spikeLeft = this.xpos - (this.w / 3);
    float spikeRight = this.xpos + (this.w / 3);
    float spikeTop = this.ypos - (this.h / 2);
    float spikeBottom = this.ypos + (this.h / 2);
    
    float iconLeft = i.xpos - (i.w / 2) + 10; 
    float iconRight = i.xpos + (i.w / 2) - 10;
    float iconTop = i.ypos - (i.h / 2) + 10;
    float iconBottom = i.ypos + (i.h / 2) - 10;
    
    return (spikeLeft < iconRight && spikeRight > iconLeft &&
            spikeTop < iconBottom && spikeBottom > iconTop);
  }
}

