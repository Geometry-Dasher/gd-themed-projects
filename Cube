boolean gameEnd = false;
int respawn = 60;

icon cube;
g ground;
ArrayList<spike> spikes;

float physicsInterval = 1.0 / 240.0; 
float accumulator = 0.0;
float currentTime = 0.0;
float scaleFactor;

float blockWidth;
float lastSpawnX;
int consecutiveSpikes = 0;
int emptyBufferCount = 0;

void setup() {
  fullScreen();
  background(100, 100, 100);
  
  scaleFactor = width / 1920.0;
  blockWidth = 100 * scaleFactor;
  currentTime = millis() / 1000.0;
  
  cube = new icon(350 * scaleFactor, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor);
  ground = new g(0, 2 * height / 3, width, height / 3);
  
  spikes = new ArrayList<spike>();
  resetLevel();
}

void resetLevel() {
  spikes.clear();
  consecutiveSpikes = 0;
  emptyBufferCount = 5; 
  lastSpawnX = width;
  
  for (int i = 0; i < 15; i++) {
    generateNextBlock();
  }
}

void generateNextBlock() {
  boolean spawnSpike = false;
  
  if (emptyBufferCount > 0) {
    emptyBufferCount--;
  } else if (consecutiveSpikes >= 3) {
    consecutiveSpikes = 0;
    emptyBufferCount = 5 - 1; 
  } else {
    float rand = random(1.0);
    if (rand < 0.4) { 
      spawnSpike = true;
      consecutiveSpikes++;
    } else {
      consecutiveSpikes = 0;
      emptyBufferCount = 5 - 1; 
    }
  }
  
  if (spawnSpike) {
    spikes.add(new spike(lastSpawnX, (2 * height / 3) - (50 * scaleFactor), 100 * scaleFactor, 100 * scaleFactor));
  }
  
  lastSpawnX += blockWidth;
}

void draw() {
  float newTime = millis() / 1000.0;
  float frameTime = newTime - currentTime;
  currentTime = newTime;

  if (frameTime > 0.1) frameTime = 0.1; 
  accumulator += frameTime;

  while (accumulator >= physicsInterval) {
    updateGamePhysics(physicsInterval);
    accumulator -= physicsInterval;
  }

  background(100, 100, 100); 
  ground.display();
  cube.display();
  for (spike s : spikes) {
    s.display();
  }
}

void updateGamePhysics(float dt) {
  if (!gameEnd) {
    cube.update(dt); 
    
    lastSpawnX -= 850 * scaleFactor * dt;
    
    for (int i = spikes.size() - 1; i >= 0; i--) {
      spike s = spikes.get(i);
      s.update(dt);
      
      if (s.collides(cube)) {
        gameEnd = true;
      }
      
      if (s.xpos < -150 * scaleFactor) {
        spikes.remove(i);
      }
    }
    
    while (lastSpawnX < width + 300 * scaleFactor) {
      generateNextBlock();
    }
    
  } else {
    respawn--;
    if (respawn <= 0) {
      gameEnd = false;
      respawn = 60;
      cube.angle = 0;
      cube.ypos = (2 * height / 3) - (cube.h / 2);
      cube.ySpeed = 0;
      resetLevel();
    }
  }
}

void mousePressed() {
  cube.jump();
}

class g {
  float xpos, ypos, w, h;
  g (float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
  }
  void display() {
    rectMode(CORNER);
    noStroke();
    fill(255);
    rect(xpos, ypos, w, h);
  }
}

class icon {
  float ySpeed = 0;
  float xpos, ypos, w, h;
  float angle = 0; 
  
  float gravity; 
  float jumpVelocity; 

  icon(float x, float y, float w, float h) {
    this.xpos = x; this.ypos = y; this.w = w; this.h = h;
    this.gravity = 4500 * scaleFactor;
    this.jumpVelocity = 1400 * scaleFactor;
  }

  void update(float dt) {
    ySpeed -= gravity * dt;
    ypos -= ySpeed * dt;

    if (ypos >= (2 * height / 3) - h/2) {
      ypos = (2 * height / 3) - h/2;
      ySpeed = 0;
      angle = round(angle / PI) * PI; 
    } else {
      angle += 5.05 * dt; 
    }
  }

  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rotate(angle);
    rectMode(CENTER);
    fill(0, 200, 255);
    stroke(0);
    strokeWeight(4 * scaleFactor);
    rect(0, 0, w, h);
    fill(100, 100, 100);
    rect(0, 0, w - (40 * scaleFactor), h - (40 * scaleFactor));
    popMatrix(); 
  }
  
  void jump() {
    if (ypos >= (2 * height / 3) - h/2 - (2 * scaleFactor)) {
      ySpeed = jumpVelocity; 
    }
  }
}

class spike {
  float xSpeed; 
  float xpos, ypos, w, h;
  
  spike (float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
    this.xSpeed = 850 * scaleFactor;
  }
  
  void update(float dt) {
    xpos -= xSpeed * dt;
  }
  
  void display() {
    pushMatrix();
    translate(xpos, ypos);
    rectMode(CENTER);
    fill(255, 0, 0);
    noStroke();
    rect(0, 0, w/4, h/2);
    
    fill(0);
    stroke(255);
    strokeWeight(4 * scaleFactor);
    triangle(w/2, h/2, -w/2, h/2, 0, -h/2);
    popMatrix();
  }
  
  boolean collides(icon i) {
    float sLeft = this.xpos - (this.w / 6.0);
    float sRight = this.xpos + (this.w / 6.0);
    float sTop = this.ypos - (this.h / 4.0);
    float sBottom = this.ypos + (this.h / 2);

    float halfW = (i.w / 2.5);
    float halfH = (i.h / 2.5);

    float[][] origCorners = {
      {-halfW, -halfH},
      {halfW, -halfH},
      {halfW, halfH},
      {-halfW, halfH}
    };

    float cosA = cos(i.angle);
    float sinA = sin(i.angle);
    float[][] rotCorners = new float[4][2];

    for (int j = 0; j < 4; j++) {
      rotCorners[j][0] = i.xpos + (origCorners[j][0] * cosA - origCorners[j][1] * sinA);
      rotCorners[j][1] = i.ypos + (origCorners[j][0] * sinA + origCorners[j][1] * cosA);
    }

    float cLeft = rotCorners[0][0];
    float cRight = rotCorners[0][0];
    float cTop = rotCorners[0][1];
    float cBottom = rotCorners[0][1];

    for (int j = 1; j < 4; j++) {
      if (rotCorners[j][0] < cLeft) cLeft = rotCorners[j][0];
      if (rotCorners[j][0] > cRight) cRight = rotCorners[j][0];
      if (rotCorners[j][1] < cTop) cTop = rotCorners[j][1];
      if (rotCorners[j][1] > cBottom) cBottom = rotCorners[j][1];
    }

    return (sLeft < cRight && sRight > cLeft && sTop < cBottom && sBottom > cTop);
  }
}
