boolean gameEnd = false;
boolean input = false;
int respawn = 60;
int gravity = 1;

ship Player;
border top;
border bottom;
wall w;

void setup() {
  size(1920, 1080);
  Player = new ship(300, 2 * height / 3, 100, 100);
  top = new border(0, 0, width, 100);
  bottom = new border(0, 2 * height / 3 + 50, width, 100);
  background(100, 100, 100);
  w = new wall(2000, (2 * height / 3 - 100) / 2, 100, 400);
}

void draw() {
  background(100, 100, 100);

  top.display();
  bottom.display();
  Player.display();
  w.display();

  if (!gameEnd) {
    Player.update(gravity);
    w.update();

    if (Player.checkCollision(w)) {
      gameEnd = true;
    }
  } else {
    respawn--;

    if (respawn == 0) {
      Player.ypos = 2 * height / 3;
      w.xpos = 2000;
      Player.velocity = 0;
      gameEnd = false;
      respawn = 60;
      gravity = int(random(1, 3));
      Player.gravityMode = gravity;
    }
  }
}

void keyPressed() {
  if (key == 'w' || key == 'W' || key == ' ') {
    input = true;
  } else if (key == CODED) {
    if (keyCode == UP) {
      input = true;
    }
  }
}

void keyReleased() {
  if (key == 'w' || key == 'W' || key == ' ') {
    input = false;
  } else if (key == CODED) {
    if (keyCode == UP) {
      input = false;
    }
  }
}

void mousePressed() {
  input = true;
}

void mouseReleased() {
  input = false;
}

class border {
  float xpos, ypos, w, h;

  border(float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }

  void display() {
    rectMode(CORNER);
    fill(255);
    noStroke();
    rect(xpos, ypos, w, h);
  }
}

class ship {
  float xpos, ypos, w, h;
  float velocity = 0;
  float gravity = 0.8;
  float thrust = -0.8;
  float friction = 0.95;
  float maxVelocity = 15;
  int gravityMode = 1;

  ship(float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }

  void display() {
    float vx = 13;
    float angle = atan2(velocity, vx);
  
    pushMatrix();
    translate(xpos, ypos);
  
    if (gravityMode == 2) {
      scale(1, -1);
      rotate(-angle);
    } else {
      rotate(angle);
    }
  

    fill(0, 200, 255);
    stroke(0);
    strokeWeight(4);
  
    beginShape();
    vertex(-45, 25);
    vertex(-45, -25);
    vertex(15, -25);
    vertex(45, 0);
    vertex(15, 25);
    endShape(CLOSE);
  

    fill(100, 100, 100);
    noStroke();
  
    beginShape();
    vertex(-25, 12);
    vertex(-25, -12);
    vertex(10, -12);
    vertex(25, 0);
    vertex(10, 12);
    endShape(CLOSE);
  
    popMatrix();
  }
  void update(int gravityMode) {
    this.gravityMode = gravityMode;

    float currentGravity = (gravityMode == 2) ? -0.8 : 0.8;
    float currentThrust = (gravityMode == 2) ? 0.8 : -0.8;

    if (input) {
      velocity += currentThrust;
    } else {
      velocity += currentGravity;
    }

    velocity *= friction;
    velocity = constrain(velocity, -maxVelocity, maxVelocity);
    ypos += velocity;

    if (ypos < 150) {
      ypos = 150;
      velocity = 0;
    } else if (ypos > 2 * height / 3) {
      ypos = 2 * height / 3;
      velocity = 0;
    }
  }

  boolean checkCollision(wall w) {
    float shipLeft = xpos - 45;
    float shipRight = xpos + 45;
    float shipTop = ypos - 25;
    float shipBottom = ypos + 25;
  
    float wallLeft = w.xpos - w.w / 2;
    float wallRight = w.xpos + w.w / 2;
  
    float upperTop = w.ypos - 500;
    float upperBottom = w.ypos - 100;
  
    float lowerTop = w.ypos + 100;
    float lowerBottom = w.ypos + 500;
  
    boolean hitsUpper =
      shipRight > wallLeft &&
      shipLeft < wallRight &&
      shipBottom > upperTop &&
      shipTop < upperBottom;
  
    boolean hitsLower =
      shipRight > wallLeft &&
      shipLeft < wallRight &&
      shipBottom > lowerTop &&
      shipTop < lowerBottom;
  
    return hitsUpper || hitsLower;
  }
}

class wall {
  float xSpeed = 13;
  float xpos, ypos, w, h;

  wall(float x, float y, float w, float h) {
    this.xpos = x;
    this.ypos = y;
    this.w = w;
    this.h = h;
  }

  void display() {
    fill(255);
    noStroke();
    rectMode(CENTER);
    rect(xpos, ypos - 300, w, 400);
    rect(xpos, ypos + 300, w, 400);
  }

  void update() {
    xpos -= xSpeed;

    if (xpos <= -100) {
      xpos = 2000;
      ypos = int(random(400, 600));
    }
  }
}
